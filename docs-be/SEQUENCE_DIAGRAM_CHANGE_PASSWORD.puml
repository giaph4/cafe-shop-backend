@startuml Change Password Sequence Diagram

title Use Case: Đổi mật khẩu (Change Password)

skinparam sequenceMessageAlign center
skinparam sequenceArrowThickness 2
skinparam roundcorner 10
skinparam maxmessagesize 60

actor User as user
participant ":JwtAuthenticationFilter" as jwtFilter
participant ":JwtService" as jwtService
participant ":UserController" as controller
participant ":UserService" as userService
participant ":UserRepository" as userRepo
participant ":PasswordEncoder" as passwordEncoder
database "Database" as db

user -> controller: POST /api/v1/users/change-password\n(ChangePasswordRequest)\nAuthorization: Bearer <token>
activate controller

controller -> jwtFilter: Validate JWT token
activate jwtFilter

jwtFilter -> jwtService: validateToken(token)
activate jwtService
jwtService -> jwtService: parseToken(token)
jwtService -> jwtService: checkExpiration(claims)
jwtService --> jwtFilter: Claims (userId, username, roles)
deactivate jwtService

alt [Token không hợp lệ hoặc hết hạn]
    jwtFilter --> controller: throw AuthenticationException
    controller --> user: HTTP 401 Unauthorized
    deactivate jwtFilter
    deactivate controller
else [Token hợp lệ]
    jwtFilter --> controller: OK (set SecurityContext)
    deactivate jwtFilter
    
    controller -> controller: @Valid validation
    controller -> userService: changePassword(request)
    activate userService
    
    userService -> userService: getCurrentUser()\n(từ SecurityContext)
    userService -> userRepo: findById(userId)
    activate userRepo
    userRepo -> db: SELECT User WHERE id=?
    db --> userRepo: Optional<User>
    userRepo --> userService: User
    deactivate userRepo
    
    alt [User không tồn tại]
        userService --> controller: throw EntityNotFoundException
        controller --> user: HTTP 404 Not Found
        deactivate userService
        deactivate controller
    else [User tồn tại]
        userService -> passwordEncoder: matches(currentPassword, user.password)
        activate passwordEncoder
        passwordEncoder --> userService: boolean
        deactivate passwordEncoder
        
        alt [Mật khẩu hiện tại sai]
            userService --> controller: throw IllegalArgumentException\n("Current password is incorrect")
            controller --> user: HTTP 400 Bad Request
            deactivate userService
            deactivate controller
        else [Mật khẩu hiện tại đúng]
            userService -> userService: validateNewPassword(newPassword, confirmPassword)
            
            alt [Mật khẩu mới không hợp lệ hoặc không khớp]
                userService --> controller: throw IllegalArgumentException\n("New password must..." hoặc "Passwords do not match")
                controller --> user: HTTP 400 Bad Request
                deactivate userService
                deactivate controller
            else [Mật khẩu mới hợp lệ]
                userService -> passwordEncoder: matches(newPassword, user.password)
                activate passwordEncoder
                passwordEncoder --> userService: boolean
                deactivate passwordEncoder
                
                alt [Mật khẩu mới trùng với mật khẩu cũ]
                    userService --> controller: throw IllegalArgumentException\n("New password must be different from current password")
                    controller --> user: HTTP 400 Bad Request
                    deactivate userService
                    deactivate controller
                else [Mật khẩu mới khác mật khẩu cũ]
                    userService -> passwordEncoder: encode(newPassword)
                    activate passwordEncoder
                    passwordEncoder --> userService: encodedPassword
                    deactivate passwordEncoder
                    
                    userService -> user: setPassword(encodedPassword)
                    userService -> userRepo: save(user)
                    activate userRepo
                    userRepo -> db: UPDATE User SET password=?
                    db --> userRepo: User entity
                    userRepo --> userService: User
                    deactivate userRepo
                    
                    userService --> controller: void (success)
                    deactivate userService
                    
                    controller --> user: HTTP 200 OK
                    deactivate controller
                end
            end
        end
    end
end

@enduml

