{
  "title": "ConversationSummaryDTO",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "updatedAt",
    "unreadCount",
    "pinned",
    "participants"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "format": "int64"
    },
    "title": {
      "anyOf": [
        { "type": "string", "maxLength": 120 },
        { "type": "null" }
      ]
    },
    "avatarUrl": {
      "anyOf": [
        { "type": "string", "format": "uri", "maxLength": 512 },
        { "type": "null" }
      ]
    },
    "type": {
      "type": "string",
      "enum": ["DIRECT", "GROUP"]
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "lastMessage": {
      "anyOf": [
        { "type": "null" },
        { "$ref": "message.schema.json" }
      ]
    },
    "unreadCount": {
      "type": "integer",
      "minimum": 0
    },
    "pinned": {
      "type": "boolean"
    },
    "participants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "conversation-member.schema.json"
      }
    }
  }
}
