{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.example.com/schemas/user.schema.json",
  "title": "UserDTO",
  "type": "object",
  "required": [
    "id",
    "username",
    "fullName",
    "roles",
    "avatarUrl"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "format": "int64",
      "minimum": 1
    },
    "username": {
      "type": "string",
      "minLength": 3,
      "maxLength": 50
    },
    "fullName": {
      "type": "string"
    },
    "email": {
      "type": [
        "string",
        "null"
      ],
      "format": "email"
    },
    "phone": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\+?[0-9]{7,15}$"
    },
    "avatarUrl": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string"
    }
  }
}
