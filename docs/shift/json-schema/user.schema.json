{
  "title": "UserDTO",
  "type": "object",
  "required": [
    "id",
    "username",
    "fullName",
    "roles",
    "avatarUrl"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "format": "int64",
      "minimum": 1
    },
    "username": {
      "type": "string",
      "minLength": 3,
      "maxLength": 50
    },
    "fullName": {
      "type": "string"
    },
    "email": {
      "oneOf": [
        { "type": "string", "format": "email" },
        { "type": "null" }
      ]
    },
    "phone": {
      "oneOf": [
        { "type": "string", "pattern": "^\\\+?[0-9]{7,15}$" },
        { "type": "null" }
      ]
    },
    "avatarUrl": {
      "oneOf": [
        { "type": "string", "format": "uri" },
        { "type": "null" }
      ]
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string"
    }
  }
}
