{
  "title": "ShiftSessionResponseDTO",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "workShiftId",
    "userId",
    "username",
    "startAt",
    "status",
    "adminOverride",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "format": "int64"
    },
    "workShiftId": {
      "type": "integer",
      "format": "int64"
    },
    "userId": {
      "type": "integer",
      "format": "int64"
    },
    "username": {
      "type": "string",
      "maxLength": 100
    },
    "fullName": {
      "anyOf": [
        { "type": "string", "maxLength": 255 },
        { "type": "null" }
      ]
    },
    "startAt": {
      "type": "string",
      "format": "date-time"
    },
    "endAt": {
      "anyOf": [
        { "type": "string", "format": "date-time" },
        { "type": "null" }
      ]
    },
    "status": {
      "type": "string",
      "enum": ["ACTIVE", "CLOSED", "FORCED"]
    },
    "adminOverride": {
      "type": "boolean"
    },
    "forceReason": {
      "anyOf": [
        { "type": "string", "maxLength": 255 },
        { "type": "null" }
      ]
    },
    "forceByUserId": {
      "anyOf": [
        { "type": "integer", "format": "int64" },
        { "type": "null" }
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
