{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.coffeeshop.local/chat/schemas/conversation.schema.json",
  "title": "Conversation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "updatedAt",
    "participants",
    "unreadCount",
    "pinned"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "format": "int64"
    },
    "type": {
      "type": "string",
      "enum": ["DIRECT", "GROUP"]
    },
    "title": {
      "type": ["string", "null"],
      "maxLength": 120
    },
    "avatarUrl": {
      "type": ["string", "null"],
      "format": "uri"
    },
    "createdBy": {
      "type": ["integer", "null"],
      "format": "int64"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "lastMessage": {
      "$ref": "message.schema.json"
    },
    "unreadCount": {
      "type": "integer",
      "minimum": 0
    },
    "pinned": {
      "type": "boolean"
    },
    "participants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "conversation-member.schema.json"
      }
    }
  }
}
