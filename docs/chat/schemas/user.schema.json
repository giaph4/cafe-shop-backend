{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.coffeeshop.local/chat/schemas/user.schema.json",
  "title": "User",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "username", "fullName", "roles"],
  "properties": {
    "id": {
      "type": "integer",
      "format": "int64",
      "description": "ID người dùng"
    },
    "username": {
      "type": "string",
      "maxLength": 100,
      "description": "Tên đăng nhập duy nhất"
    },
    "fullName": {
      "type": "string",
      "maxLength": 255,
      "description": "Tên hiển thị"
    },
    "email": {
      "type": ["string", "null"],
      "format": "email",
      "description": "Địa chỉ email"
    },
    "phone": {
      "type": ["string", "null"],
      "maxLength": 20,
      "description": "Số điện thoại"
    },
    "avatarUrl": {
      "type": ["string", "null"],
      "format": "uri",
      "description": "Ảnh đại diện"
    },
    "statusMessage": {
      "type": ["string", "null"],
      "maxLength": 255,
      "description": "Trạng thái tùy chỉnh"
    },
    "lastSeenAt": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "Thời điểm online cuối"
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "maxLength": 50
      }
    }
  }
}
